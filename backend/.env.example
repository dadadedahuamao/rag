# 复制自 .env.example —— 请按你的本地环境修改下列 3 处：
#   1) DATABASE_URL 中的 MySQL 账号密码
#   2) ELASTICSEARCH_USERNAME / ELASTICSEARCH_PASSWORD
#   3) LLM_API_KEY（DeepSeek 密钥，留空则问答走内置模拟回答）

# ===== 应用基础 =====
APP_NAME=企业级RAG知识库系统
APP_SECRET_KEY=change-me-to-a-random-long-string
ACCESS_TOKEN_EXPIRE_MINUTES=120000
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== MySQL（请填写你的账号密码）=====
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/rag_kb?charset=utf8mb4

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/3

# ===== Elasticsearch =====
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=123456
ES_INDEX_PREFIX=rag_kb
ES_VERIFY_CERTS=false

# ===== 大模型 =====
LLM_API_KEY=xxx
LLM_BASE_URL=xxx
LLM_MODEL=xxx
LLM_ENABLED=true

# ===== 向量嵌入 =====
EMBEDDING_DIM=256

# ===== 文件与任务 =====
UPLOAD_DIR=./data/uploads
TASK_MODE=thread
